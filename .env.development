# Node Environment
NODE_ENV=development
PORT=3010

SWAGGER_TITLE=INDT Educacional
SWAGGER_DESCRIPTION=API do INDT Educacional (app estilo Duolingo)
SWAGGER_VERSION=1.0
SWAGGER_API_URL=http://localhost:3010

# Database (local: docker-compose mapeia host 5450 -> container 5432)
DB_HOST=localhost
DB_PORT=5450
DB_DATABASE=educacional
DB_USERNAME=postgres
DB_PASSWORD=pass123

# Usado pelo container do postgres (serviço db do docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass123
POSTGRES_DB=educacional

# JWT
JWT_SECRET=dev-secret-educacional
JWT_EXPIRES_IN=30d

# Conteúdo (opcional; padrão: <cwd>/content)
# CONTENT_DIR=/caminho/para/content

LOG_LEVEL=debug
